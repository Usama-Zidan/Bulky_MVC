@page
@model BulkyWeb_Razor.Pages.Categories.IndexModel

<div class="container">
	<div class="row pt-4 pb-3">
	    <div class="col-6">
	        <h2 class="text-primary"> Category List </h2>
	    </div>
	    <div class="col-6 text-end">
			<a asp-page="categories/create" class="btn btn-dark"> <i class="bi bi-plus-circle"></i>  New Category </a>
		</div>
	</div>
    <table class="table table-bordered table-striped">
         <thead>
            <tr>
            	<th>
            		Category Name
            	</th>
            	<th>
            		Display order
            	</th>
				<th> </th>
            </tr>
         </thead>
         <tbody>
	     	@foreach (var ct in Model.categoryList.OrderBy(u=>u.DisplayOrder)) {
	     		<tr>
	     			<td>
	     				@ct.Name
	     			</td>
	     			<td>
	     				@ct.DisplayOrder
	     			</td>
					 <td>
						 <div class="w-75 btn-group" role="group">
							<a asp-page="category/edit" asp-route-id="@ct.Id" class="btn btn-primary mx-2">
								<i class="bi bi-pencil-square"></i> Edit
						     </a>
							<a asp-page="category/delete" asp-route-id="@ct.Id" class="btn btn-danger mx-2">
								<i class="bi bi-trash-fill"></i> Delete
							</a>
						 </div>
					 </td>
	     		</tr>
	     	}
	     </tbody>
	</table>
</div>
